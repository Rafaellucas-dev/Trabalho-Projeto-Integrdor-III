@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');
:root {
    --bg-main: #090d16;
    --bg-card: rgba(17, 25, 40, 0.75);
    --border-card: rgba(255, 255, 255, 0.08);
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --primary: #6366f1;
    --primary-glow: rgba(99, 102, 241, 0.15);
    --accent: #06b6d4;
    --success: #10b981;
    --success-bg: rgba(16, 185, 129, 0.1);
    --warning: #f59e0b;
    --warning-bg: rgba(245, 158, 11, 0.1);
s--danger: #ef4444;
    --danger-bg: rgba(239, 68, 68, 0.1);
    --font-sans: 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --sidebar-width: 280px;
}
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; font-family:var(--font-sans); }
body {
    background: var(--bg-main);
    color: var(--text-primary);
    min-height: 100vh;
    overflow-x: hidden;
}
/* ── ambient glows ── */
.bg-glow-1 {
    position:fixed; top:-10%; left:-10%; width:50vw; height:50vh;
    background:radial-gradient(circle,rgba(99,102,241,.12) 0%,transparent 70%);
    z-index:-1; pointer-events:none;
}
.bg-glow-2 {
    position:fixed; bottom:-10%; right:-10%; width:60vw; height:60vh;
    background:radial-gradient(circle,rgba(6,182,212,.10) 0%,transparent 70%);
    z-index:-1; pointer-events:none;
}
/* ── scrollbar ── */
::-webkit-scrollbar { width:8px; }
::-webkit-scrollbar-track { background:var(--bg-main); }
::-webkit-scrollbar-thumb { background:rgba(255,255,255,.10); border-radius:4px; }
::-webkit-scrollbar-thumb:hover { background:rgba(255,255,255,.20); }
/* ── layout ── */
.app-container { display:flex; width:100vw; min-height:100vh; }
/* ── sidebar ── */
.sidebar {
    width:var(--sidebar-width); background:rgba(10,15,30,.85);
    backdrop-filter:blur(16px); border-right:1px solid var(--border-card);
    padding:2.5rem 1.5rem; display:flex; flex-direction:column;
    position:fixed; height:100vh; z-index:100;
}
.brand-section { display:flex; align-items:center; gap:.75rem; margin-bottom:3.5rem; }
.brand-icon { font-size:1.75rem; color:var(--primary); text-shadow:0 0 12px var(--primary); }
.brand-name {
    font-size:1.35rem; font-weight:700; letter-spacing:-.5px;
    background:linear-gradient(135deg,#fff 30%,var(--text-secondary) 100%);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
}
.nav-links { list-style:none; display:flex; flex-direction:column; gap:.75rem; }
.nav-item button {
    width:100%; background:transparent; border:none; outline:none;
    padding:.95rem 1.25rem; border-radius:12px; display:flex; align-items:center;
    gap:1rem; color:var(--text-secondary); font-size:.95rem; font-weight:500;
    cursor:pointer; text-align:left; transition:var(--transition-smooth);
}
.nav-item button i { font-size:1.15rem; transition:var(--transition-smooth); }
.nav-item button:hover { color:var(--text-primary); background:rgba(255,255,255,.03); }
.nav-item.active button {
    color:var(--text-primary); background:var(--primary-glow);
    border:1px solid rgba(99,102,241,.25); box-shadow:0 4px 20px rgba(99,102,241,.05);
}
.nav-item.active button i { color:var(--primary); text-shadow:0 0 8px var(--primary); }
.sidebar-footer {
    margin-top:auto; font-size:.75rem; color:var(--text-secondary);
    text-align:center; border-top:1px solid var(--border-card); padding-top:1.5rem;
}
/* ── main ── */
.main-content { margin-left:var(--sidebar-width); flex:1; padding:2.5rem 3.5rem; min-height:100vh; }
/* ── view sections ── */
.view-section { display:none; animation:fadeIn .4s ease-out forwards; }
.view-section.active { display:block; }
@keyframes fadeIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
/* ── typography ── */
.section-header { margin-bottom:2.5rem; }
.section-title {
    font-size:2.25rem; font-weight:800; letter-spacing:-1px; margin-bottom:.5rem;
    background:linear-gradient(135deg,#fff 0%,#a5b4fc 100%);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
}
.section-desc { color:var(--text-secondary); font-size:1.05rem; }
/* ── glass panel ── */
.glass-panel {
    background:var(--bg-card); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);
    border:1px solid var(--border-card); border-radius:20px; padding:2rem;
    margin-bottom:2rem; box-shadow:0 8px 32px rgba(0,0,0,.37);
    transition:var(--transition-smooth);
}
.glass-panel:hover { border-color:rgba(255,255,255,.12); }
.panel-title { font-size:1.25rem; font-weight:700; margin-bottom:1.5rem; }
/* ── hero card ── */
.hero-card {
    background:linear-gradient(135deg,rgba(99,102,241,.10) 0%,rgba(6,182,212,.05) 100%);
    border:1px solid rgba(99,102,241,.2); display:flex; gap:2rem; align-items:center;
}
.hero-text h1 { font-size:2.5rem; font-weight:800; margin-bottom:1rem; line-height:1.2; }
.hero-text p { color:var(--text-secondary); font-size:1.1rem; margin-bottom:1.5rem; line-height:1.6; }
.cta-button {
    background:linear-gradient(135deg,var(--primary) 0%,var(--accent) 100%);
    color:#fff; border:none; padding:.85rem 2rem; font-size:1rem; font-weight:600;
    border-radius:12px; cursor:pointer; box-shadow:0 4px 15px rgba(99,102,241,.3);
    transition:var(--transition-smooth);
}
.cta-button:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(99,102,241,.45); }
/* ── stat grid ── */
.stat-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1.5rem; margin-bottom:2.5rem; }
.stat-card { text-align:center; padding:1.75rem; }
.stat-icon { font-size:2.25rem; color:var(--accent); margin-bottom:1rem; text-shadow:0 0 15px rgba(6,182,212,.2); }
.stat-value { font-size:2rem; font-weight:800; margin-bottom:.25rem; }
.stat-label { color:var(--text-secondary); font-size:.9rem; font-weight:500; }
/* ── charts ── */
.chart-container { width:100%; min-height:320px; display:flex; align-items:center; justify-content:center; position:relative; }
.grid-2col { display:grid; grid-template-columns:1fr 1fr; gap:2rem; }
/* ── heatmap table ── */
.heatmap-table { width:100%; border-collapse:collapse; margin-top:1rem; font-size:.8rem; overflow-x:auto; display:block; }
.heatmap-table th,.heatmap-table td { padding:.6rem .5rem; text-align:center; border:1px solid rgba(255,255,255,.05); white-space:nowrap; }
.heatmap-table th { background:rgba(255,255,255,.02); color:var(--text-primary); font-weight:600; }
/* ── svg bar / tooltip ── */
.svg-bar { transition:fill .3s; cursor:pointer; }
.svg-bar:hover { filter:brightness(1.3); }
/* ── input form ── */
.form-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:1.5rem; margin-bottom:2rem; }
.input-group { display:flex; flex-direction:column; gap:.5rem; }
.input-label { font-size:.95rem; font-weight:600; color:var(--text-primary); }
.input-desc { font-size:.75rem; color:var(--text-secondary); margin-top:-.25rem; }
.input-wrapper { position:relative; }
.input-currency-prefix {
    position:absolute; left:1rem; top:50%; transform:translateY(-50%);
    color:var(--text-secondary); font-size:.95rem; font-weight:500;
}
.form-input {
    width:100%; background:rgba(0,0,0,.2); border:1px solid var(--border-card);
    border-radius:12px; padding:.85rem 1rem .85rem 2.25rem; color:var(--text-primary);
    font-size:1rem; font-weight:500; transition:var(--transition-smooth); outline:none;
}
.form-input.no-prefix { padding-left:1rem; }
.form-input:focus { border-color:var(--primary); box-shadow:0 0 0 3px rgba(99,102,241,.15); }
.form-actions { display:flex; justify-content:flex-end; gap:1rem; margin-top:2rem; }
.btn-secondary {
    background:rgba(255,255,255,.05); color:var(--text-primary);
    border:1px solid var(--border-card); padding:.85rem 2rem; font-size:1rem;
    font-weight:600; border-radius:12px; cursor:pointer; transition:var(--transition-smooth);
}
.btn-secondary:hover { background:rgba(255,255,255,.08); }
/* ── results ── */
.results-dashboard { display:none; animation:slideUp .5s ease-out forwards; }
.results-dashboard.active { display:block; }
@keyframes slideUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
.results-header-panel {
    display:flex; gap:3rem; align-items:center;
    background:linear-gradient(135deg,rgba(15,23,42,.8) 0%,rgba(10,15,30,.9) 100%);
}
.score-gauges { display:flex; flex-wrap:wrap; gap:3rem; flex:1; justify-content:space-around; }
.gauge-item { display:flex; flex-direction:column; align-items:center; text-align:center; }
.gauge-svg-wrapper { position:relative; width:160px; height:160px; }
.gauge-text-overlay {
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center;
}
.gauge-value { font-size:1.75rem; font-weight:800; }
.gauge-label-overlay { font-size:.7rem; color:var(--text-secondary); text-transform:uppercase; letter-spacing:.5px; }
.risk-badge {
    padding:.5rem 1rem; border-radius:20px; font-size:.85rem; font-weight:700;
    text-transform:uppercase; letter-spacing:.5px; display:inline-block; margin-top:1rem;
}
.risk-safe { background:var(--success-bg); color:var(--success); border:1px solid rgba(16,185,129,.2); }
.risk-alert { background:var(--warning-bg); color:var(--warning); border:1px solid rgba(245,158,11,.2); }
.risk-danger { background:var(--danger-bg); color:var(--danger); border:1px solid rgba(239,68,68,.2); }
/* ── comparison cards ── */
.comparison-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1.5rem; margin-top:2rem; }
.comparison-card { background:rgba(0,0,0,.15); border:1px solid var(--border-card); border-radius:16px; padding:1.5rem; }
.comparison-title { font-size:.95rem; font-weight:700; margin-bottom:1rem; border-bottom:1px solid rgba(255,255,255,.05); padding-bottom:.5rem; }
.comp-metric-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:.75rem; font-size:.85rem; }
.comp-metric-label { color:var(--text-secondary); }
.comp-metric-value { font-weight:600; }
.comp-metric-value.user-val { color:var(--accent); }
.comp-metric-value.healthy-val { color:var(--success); }
.comp-metric-value.bankrupt-val { color:var(--danger); }
.comp-bar-wrapper { height:6px; background:rgba(255,255,255,.05); border-radius:3px; overflow:hidden; position:relative; margin-top:.5rem; }
.comp-bar { height:100%; border-radius:3px; position:absolute; top:0; left:0; }
/* ── case study cards ── */
.cases-grid { display:grid; grid-template-columns:1fr; gap:2rem; }
.case-card { display:grid; grid-template-columns:320px 1fr; gap:2rem; }
.case-image-container {
    border-radius:16px; overflow:hidden; height:100%; min-height:200px; position:relative;
    background:rgba(255,255,255,.02); border:1px solid var(--border-card);
}
.case-image-fallback {
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    font-size:4rem; opacity:.15;
}
.case-content { display:flex; flex-direction:column; justify-content:center; }
.case-badge {
    align-self:flex-start; padding:.25rem .75rem; border-radius:10px;
    background:rgba(239,68,68,.1); color:var(--danger); font-size:.75rem;
    font-weight:700; margin-bottom:.75rem; border:1px solid rgba(239,68,68,.15);
}
.case-name { font-size:1.5rem; font-weight:700; margin-bottom:.5rem; }
.case-meta { font-size:.85rem; color:var(--text-secondary); margin-bottom:1rem; }
.case-description { color:var(--text-secondary); font-size:.95rem; line-height:1.6; margin-bottom:1.5rem; }
.case-metrics { display:flex; gap:1.5rem; flex-wrap:wrap; }
.case-metric-box {
    background:rgba(255,255,255,.02); border:1px solid var(--border-card);
    padding:.75rem 1.25rem; border-radius:10px; min-width:140px;
}
.case-metric-val { font-size:1.15rem; font-weight:700; color:var(--danger); }
.case-metric-lbl { font-size:.75rem; color:var(--text-secondary); margin-top:.15rem; }
/* ── methodology section ── */
.method-steps { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:1.5rem; margin-top:1.5rem; }
.method-step { padding:1.5rem; text-align:center; }
.method-step-icon { font-size:2rem; margin-bottom:.75rem; }
.method-step-title { font-weight:700; margin-bottom:.5rem; font-size:1.05rem; }
.method-step-desc { color:var(--text-secondary); font-size:.9rem; line-height:1.5; }
/* ── responsive ── */
@media(max-width:1024px){
    .sidebar { width:80px; padding:2.5rem .5rem; }
    .brand-name,.sidebar-footer,.nav-item button span { display:none; }
    .brand-section { justify-content:center; margin-bottom:2.5rem; }
    .nav-item button { justify-content:center; padding:.95rem; }
    .main-content { margin-left:80px; padding:2rem; }
    .grid-2col { grid-template-columns:1fr; }
    .case-card { grid-template-columns:1fr; }
    .case-image-container { height:220px; }
}
@media(max-width:640px){
    .main-content { padding:1.5rem; }
    .results-header-panel { flex-direction:column; gap:2rem; }
    .hero-text h1 { font-size:1.75rem; }
    .form-grid { grid-template-columns:1fr; }
}
